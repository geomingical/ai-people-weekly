{
  "name": "ai-people-weekly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "verify": "npm run test && npm run build && npm run test:e2e",
    "pipeline:run": "tsx pipeline/src/run.ts",
    "pipeline:dry": "tsx pipeline/src/run.ts --dry-run",
    "pipeline:resummarize": "tsx pipeline/src/resummarize.ts",
    "pipeline:refresh-access": "tsx pipeline/src/refresh-access.ts"
  },
  "dependencies": {
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-xml-parser": "^5.11.0",
    "linkedom": "^0.18.13",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
