---
import type { Locale } from '../domain/story';
import { t } from '../domain/i18n';
import { sitePath, withBase } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const statementLine = [
  t(locale, 'footerCadenceStatement'),
  t(locale, 'footerSourceStatement'),
  t(locale, 'footerMachineStatement'),
].join(' · ');
---

<footer class="site-footer page-shell">
  <p class="site-footer__line">
    {statementLine}
  </p>
  <p class="site-footer__line">
    <a href={sitePath(locale, '/method/')}>{t(locale, 'methodTitle')}</a>
    {' · '}
    <a href={withBase("/rss.xml")}>{t(locale, 'rssLinkLabel')}</a>
    {' · '}
    <a href="https://aimingdata.com">{t(locale, 'attributionText')}</a>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--color-rule);
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
  }

  .site-footer__line {
    margin: 0;
  }

  .site-footer a {
    color: var(--color-ink-soft);
  }
</style>
