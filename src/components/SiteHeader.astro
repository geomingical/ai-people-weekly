---
import type { Locale } from '../domain/story';
import { t } from '../domain/i18n';
import { sitePath } from '../lib/paths';

interface Props {
  locale: Locale;
  languageHref: string;
}

const { locale, languageHref } = Astro.props;
const isEnglish = locale === 'en';
const home = sitePath(locale, '/');
---

<div class="site-header-band">
  <header class="site-header page-shell">
    <a class="site-header__brand" href={home}>
      <span class="site-header__name">{t(locale, 'siteTitle')}</span>
      <span class="site-header__tagline">{t(locale, 'siteTagline')}</span>
    </a>
    <nav class="site-header__nav" aria-label={t(locale, 'navAriaLabel')}>
      <a href={home}>{t(locale, 'navThisWeek')}</a>
      <a href={sitePath(locale, '/archive/')}>{t(locale, 'navArchive')}</a>
      <a href={sitePath(locale, '/sources/')}>{t(locale, 'navSources')}</a>
      <a href={sitePath(locale, '/method/')}>{t(locale, 'navMethod')}</a>
      <a data-language-link href={languageHref}>
        {t(locale, isEnglish ? 'languageSwitchToChinese' : 'languageSwitchToEnglish')}
      </a>
    </nav>
  </header>
</div>

<style>
  /* The masthead sits on its own warm band, edge to edge. The band is what
     tells a reader at a glance that this is not the education weekly, so it
     carries the background and the rule; the header inside it only handles
     layout. */
  .site-header-band {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-rule);
  }

  .site-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__name {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .site-header__tagline {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.3;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-ink);
  }

  @media (min-width: 48rem) {
    .site-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-header__nav {
      justify-content: flex-end;
    }
  }
</style>
